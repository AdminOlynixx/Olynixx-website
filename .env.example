# Staging gate. Leave blank locally; set both on the hosted staging environment.
STAGING_USER=
STAGING_PASSWORD=

# Keep true until Louis gives written launch approval.
NOINDEX=true

# HOLD until Louis confirms the partnership in writing.
PUBLISH_PUREHEALTH=false

# Stay false until each ISO certificate is issued.
PUBLISH_ISO_BADGES=false

# HOLD until Louis confirms vs Pura Longevity / PureHealth.
PUBLISH_LONGEVITY=false

# Rise Up Lifestyle Coaching L.L.C. fronts the site until the Olynixx entity at rebrand.
PUBLISH_ENTITY=false
PUBLISH_DC=false
PUBLISH_BEST=false
PUBLISH_SEAN=false
# Stay false until CPD recognition is signed. Page stays up. Header and footer hide it.
PUBLISH_PRAXIS=false
# SW-PEMF. No copy until the agreement signs.
PUBLISH_PEMF=false
PHASE_SHOP=false

# Public origin for metadata and OG URLs.
SITE_URL=http://localhost:3000

# Legal entity — configuration, never hardcoded. Stay unpublished until PUBLISH_ENTITY=true.
# Address is one field. Do not write "Registered" until Jef sends that word.
SITE_ENTITY_NAME=
SITE_ENTITY_LICENCE=
SITE_ENTITY_LICENCE_ISSUER=
SITE_ENTITY_TRN=
SITE_ENTITY_ADDRESS=
SITE_ENTITY_JURISDICTION=
SITE_ENTITY_DATA_CONTROLLER=

# Public contact. One central set. Interim until licence renewal. Empty slots render nothing.
# Registered address is not a contact address; do not copy SITE_ENTITY_ADDRESS here.
SITE_CONTACT_EMAIL=olynixx@outlook.com
SITE_CONTACT_PHONE=058 599 7620
SITE_CONTACT_WHATSAPP=058 599 7620
SITE_CONTACT_ADDRESS=
SITE_CONTACT_MAP=
SITE_CONTACT_SLA=
SITE_CONTACT_CALENDAR=

# One inbox for every form post, with a source tag.
LEADS_INBOX=
RESEND_API_KEY=
